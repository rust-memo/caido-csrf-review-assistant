{
  "name": "caido-csrf-review-assistant",
  "version": "1.1.1",
  "private": true,
  "description": "Passive evidence-driven CSRF and CSWSH review workflow for Caido",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rust-memo/caido-csrf-review-assistant.git"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ./packages/**/src",
    "lint:fix": "eslint ./packages/**/src --fix",
    "knip": "knip",
    "build": "caido-dev build",
    "watch": "caido-dev watch"
  },
  "devDependencies": {
    "@caido-community/dev": "^0.1.7",
    "@caido/eslint-config": "0.10.0",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "happy-dom": "20.14.5",
    "knip": "6.37.0",
    "postcss-prefixwrap": "1.58.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "vue": "3.5.39"
  }
}
